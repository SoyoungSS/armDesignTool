{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "arm-case"
    },
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "kind": {
            "enum": [
              "hold",
              "move",
              "wait"
            ]
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "q_target": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "required": [
          "id",
          "kind",
          "duration_s",
          "q_target"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "source",
        "assumptions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "name",
    "phases",
    "repetitions",
    "provenance"
  ],
  "additionalProperties": false
}
