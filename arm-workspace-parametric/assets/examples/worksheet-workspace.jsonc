      0,
      0
    ],
    "rpy_rad": [
      0,
      0,
      0
    ]
  },
  // 首个样本为限位内最近零位；其余使用固定种子随机采样。
  "sampling": {
    "method": "random",
    "samples": 5000,
    "seed": 42
  },
  // 三剖面经过center_m，厚度为总厚度；体素体积仅统计已占据格子。
