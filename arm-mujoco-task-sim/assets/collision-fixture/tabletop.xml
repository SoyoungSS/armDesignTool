<mujoco model="contact_regression">
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <joint damping="0.2" armature="0.001"/>
    <geom friction="1.2 0.005 0.0001" solref="0.008 1"/>
  </default>
  <worldbody>
    <geom name="table" type="box" size="0.2 0.15 0.02" pos="0 0 -0.02"/>
    <body name="block_body" pos="0 0 0.016">
      <freejoint/>
      <geom name="block" type="box" size="0.016 0.015 0.016" mass="0.03"/>
    </body>
    <body name="carriage" pos="0 0 0.018" gravcomp="1">
      <joint name="travel" type="slide" axis="1 0 0"/>
      <joint name="lift" type="slide" axis="0 0 1"/>
      <inertial pos="0 0 0" mass="0.25" diaginertia="0.001 0.001 0.001"/>
      <site name="tcp"/>
      <body pos="0 0.07 0.04">
        <joint name="elbow" type="slide" axis="0 0 1"/>
        <geom name="forearm" type="box" size="0.025 0.015 0.012" mass="0.06"/>
      </body>
      <body pos="-0.028 0 0">
        <joint name="left_jaw" type="slide" axis="1 0 0"/>
        <geom name="left_pad" type="box" size="0.005 0.012 0.012" mass="0.03"/>
      </body>
      <body pos="0.028 0 0">
        <joint name="right_jaw" type="slide" axis="-1 0 0"/>
        <geom name="right_pad" type="box" size="0.005 0.012 0.012" mass="0.03"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="x" joint="travel" kp="800" kv="35"/>
    <position name="z" joint="lift" kp="1200" kv="40"/>
    <position name="arm_height" joint="elbow" kp="700" kv="12"/>
    <position name="jaw_l" joint="left_jaw" kp="500" kv="4"/>
    <position name="jaw_r" joint="right_jaw" kp="500" kv="4"/>
  </actuator>
</mujoco>
