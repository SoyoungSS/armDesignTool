{
  // 人型七轴单臂：在 worksheet-minimal.jsonc 的几何、轴向、质量、限位基础上增加安装与重力输入。
  // 单臂自重 3.612 kg，末端负载 3 kg；单位 m、kg、rad、m/s²。
  // 本例安装角仅用于演示，不代表实际人型机器人肩部的安装参数；实机请按坐标定义替换。
  // JSONC 支持 // 和 /* */ 注释；不支持尾逗号。删除注释即为严格 JSON。
  "schema_version": "1.0",
  "input_mode": "simple",
  "simple": {
    "name": "worksheet_single_arm_3_612kg",
    // 顺序必须从基座到末端。axis 是当前关节局部坐标轴，按右手定则。
    // length_m 是到下一轴心的段长；最后一段到末端参考点。
    // direction 是当前输出坐标系的连杆方向。本例零位均沿 -Z。
    // limits_rad 为 [下限, 上限]，不是角度；90°=1.5707963267948966 rad。
    // link_mass_kg：本段连杆质量；joint_mass_kg：当前关节模组质量。
    // 简易假设：连杆质心默认在中点，整模组质量默认集中在当前轴心。
    // 若不符合实物，应显式补 link_com_m / joint_com_m 或改用 standard。
    "segments": [
      {"name": "J1", "axis": [0, -1, 0], "length_m": 0.035, "direction": [0, 0, -1], "limits_rad": [-1.5707963267948966, 3.141592653589793], "link_mass_kg": 0.1, "joint_mass_kg": 0.961},
      {"name": "J2", "axis": [1, 0, 0], "length_m": 0.05, "direction": [0, 0, -1], "limits_rad": [-1.5707963267948966, 0], "link_mass_kg": 0.09, "joint_mass_kg": 0.485},
      {"name": "J3", "axis": [0, 0, -1], "length_m": 0.25, "direction": [0, 0, -1], "limits_rad": [-2.356194490192345, 2.356194490192345], "link_mass_kg": 0.22, "joint_mass_kg": 0.485},
      {"name": "J4", "axis": [0, -1, 0], "length_m": 0.05, "direction": [0, 0, -1], "limits_rad": [0, 2.6179938779914944], "link_mass_kg": 0.08, "joint_mass_kg": 0.485},
      {"name": "J5", "axis": [0, 0, -1], "length_m": 0.163, "direction": [0, 0, -1], "limits_rad": [-2.356194490192345, 2.356194490192345], "link_mass_kg": 0.12, "joint_mass_kg": 0.162},
      {"name": "J6", "axis": [0, 1, 0], "length_m": 0.047, "direction": [0, 0, -1], "limits_rad": [-1.5707963267948966, 1.5707963267948966], "link_mass_kg": 0.05, "joint_mass_kg": 0.162},
      {"name": "J7", "axis": [1, 0, 0], "length_m": 0.04, "direction": [0, 0, -1], "limits_rad": [-1.5707963267948966, 1.5707963267948966], "link_mass_kg": 0.05, "joint_mass_kg": 0.162}
    ]
  },
  // ===== 新输入：世界重力分量 + 基座安装朝向（需要 Skill 内核 >= 1.1.0） =====
  // W 为世界坐标系，本例约定 X 向前、Y 向左、Z 向上；B 为机械臂模型基座坐标系。
  // axis、direction、COM 等仍按原模型的局部坐标填写，不因安装角改变而手动旋转。
  // simple.base 在本例省略，表示模型根相对 B 的变换为单位变换，不表示 B 与 W 对齐。
  // installation 与根字段 gravity_m_s2 必须二选一，因此本例删除原 gravity_m_s2。
  "installation": {
    // 世界坐标系下的 [gx, gy, gz]，单位 m/s²，是有符号的加速度分量，不是力（N）。
    // 本例世界 Z 向上，故普通地球重力填 [0, 0, -9.8]；不要把 J1 轴向当作重力方向。
    // 若 W 本身未与竖直对齐，可填写实测/转换后的三个分量；普通静态地球重力模长约 9.8。
    "gravity_world_m_s2": [0, 0, -9.8],
    "base_orientation_in_world": {
      // [roll, pitch, yaw]：基座 B 相对世界 W 的安装朝向，单位 rad，不是关节角 q。
      // R_WB = Rz(yaw) * Ry(pitch) * Rx(roll)，将 B 中的向量转换到 W。
      // 本例 roll=30°、pitch=45°、yaw=0°，使重力在 B 的 X/Y/Z 三个方向均有非零分量。
      // 常见替换：B/W 对齐 [0,0,0]；绕 X 倒装 [3.141592653589793,0,0]；
      // 绕 Y 侧装 [0,1.5707963267948966,0]。这些只是明确旋转定义下的安装示例。
      "rpy_rad": [0.5235987755982988, 0.7853981633974483, 0]
    }
  },
  // 内核自动换算 g_B = transpose(R_WB) * g_W，本例约为：
  // [6.929646456, -3.464823228, -6.001249870] m/s²，模长仍为 9.8 m/s²。
  // 不要再将这个 g_B 填回 gravity_world_m_s2，也不要把同一安装角再填入 simple.base。
  // 若已知 g_B，也可以删除整个 installation，改用根字段：
  // "gravity_m_s2": [6.929646456, -3.464823228, -6.001249870]
  // 此时不保留世界安装朝向，适合仅做基座坐标系中的静力计算。
  // 负载质心相对末端参考点；本例假设与参考点重合。
  "payload": {"mass_kg": 3, "com_in_tip_m": [0, 0, 0]},
  // 典型姿态角保持与原样例一致，必须列全主动关节，q 单位为 rad。
  // 安装旋转后，“平举”只描述原 B 中的几何姿态，不保证相对世界重力仍然水平。
  // 因此使用 forward_in_base / side_in_base 命名；若需要世界水平工况，应另求对应 q。
  "poses": [
    {"name": "forward_in_base", "q": {"J1": 1.5707963267948966, "J2": 0, "J3": 0, "J4": 0, "J5": 0, "J6": 0, "J7": 0}},
    {"name": "side_in_base", "q": {"J1": 0, "J2": -1.5707963267948966, "J3": 0, "J4": 0, "J5": 0, "J6": 0, "J7": 0}}
  ],
  // 可选：删除 search 则只检查上述姿态。固定配置可复现；搜索不证明全局最大。
  "search": {"samples": 20000, "seed": 42},
  // 可选：静态需求 = 已检查最大绝对载荷 × 此系数；省略默认为 1。
  "design_factor": 1.2
}
