# Copy to /etc/arm-design-tool.env and replace paths. Never put secrets in the repo.
ARM_WEB_HOST=127.0.0.1
PORT=8787
ARM_SIM_PYTHON=/srv/armDesignTool/.venv-arm-sim/bin/python
ARM_SIM_RUNTIME_CHECKS=false
ARM_EXECUTION_MODE=local
# Agent mode (systemd EnvironmentFile syntax):
# ARM_EXECUTION_MODE=agent
# ARM_AGENT_COMMAND=/usr/bin/node
# ARM_AGENT_ARGS='["/srv/armDesignTool/srs-lab-source/server/adapters/stdio-bridge-example.mjs"]'
# STATICS_SKILL_DIR=/srv/armDesignTool/arm-statics-parametric
# WORKSPACE_SKILL_DIR=/srv/armDesignTool/arm-workspace-parametric
# MOTION_SKILL_DIR=/srv/armDesignTool/arm-kinematics-dynamics
# ARM_DEMO_RESULTS=/srv/armDesignTool-runs/dual-defaults
# Configuration selection requires a real Agent, independently of local CLI mode.
# ARM_SELECTION_AGENT_COMMAND=/path/to/your/agent-bridge
# ARM_SELECTION_AGENT_ARGS='[]'
ARM_SELECTION_TIMEOUT_MS=300000
# ARM_CONFIGURATION_SKILL_DIR=/srv/armDesignTool/arm-configuration-selection

# Temporary default: use local Codex when no external Agent command is set.
# ARM_CODEX_CLI=/srv/armDesignTool/.runtime/codex-cli/node_modules/.bin/codex
# ARM_CODEX_MODEL=gpt-6.2-sol
# ARM_SELECTION_PROVIDER=external  # disable automatic Codex fallback
# Scenario simulation: dedicated worker Python and persistent job/model store.
# ARM_SCENE_PYTHON=/srv/armDesignTool/.runtime/scene-python/bin/python
# ARM_SCENE_STORAGE=/srv/arm-design-data/scenes
# ARM_SCENE_SKILL_DIR=/srv/armDesignTool/arm-mujoco-task-sim
# ARM_SCENE_AGENT_COMMAND=/path/to/your/agent-bridge
# ARM_SCENE_AGENT_ARGS='[]'
ARM_SCENE_AGENT_TIMEOUT_MS=300000
ARM_SCENE_RUN_TIMEOUT_MS=300000
ARM_SCENE_MAX_SIM_SECONDS=120
